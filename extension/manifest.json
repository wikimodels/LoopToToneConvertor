{
  "manifest_version": 3,
  "name": "LoopToTone App Check Bridge",
  "version": "1.0.0",
  "description": "Captures the Firebase App Check token from chordmini.me and delivers it to the local LoopToToneConvertor engine (127.0.0.1:8002).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chordmini.me/*",
    "http://127.0.0.1:8002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://chordmini.me/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chordmini.me/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LoopToTone App Check Bridge",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}