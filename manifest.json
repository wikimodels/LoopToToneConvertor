{
  "manifest_version": 3,
  "name": "LoopToToneConvertor",
  "version": "1.1.0",
  "description": "Управление LoopToToneConvertor: биты/аккорды/тональность, JSON+MIDI, прогресс. Ловит App Check токен на chordmini.me и передаёт движку.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://chordmini.me/*",
    "http://127.0.0.1:8002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://chordmini.me/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chordmini.me/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LoopToToneConvertor",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}